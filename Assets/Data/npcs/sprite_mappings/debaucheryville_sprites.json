              "loop": true,
              "triggers_particle": "fake_coin_trails",
              "triggers_audio": "coin_toss_sound",
              "animation_notes": "Exaggerated juggling motion, occasional coin drops",
              "cycle_duration": 2.4
            },
            "desperate_pitch": {
              "frames": [[192, 0, 32, 32], [224, 0, 32, 32], [192, 0, 32, 32]],
