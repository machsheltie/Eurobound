              "animation_notes": "Condescending hand gesture, crypto superiority complex"
            },
            "annoyed": {
              "frames": [[96, 96, 32, 32], [128, 96, 32, 32]],
              "frame_duration": 0.5,
              "loop": true,
              "animation_notes": "Crossed arms, frustrated crypto educator"
            },
            "bribed": {
              "frames": [[160, 96, 32, 32], [192, 96, 32, 32]],
              "frame_duration": 0.7,
              "loop": false,
              "triggers_audio": "coins_jingling",
              "animation_notes": "Satisfied nod, NFT verification gesture"
