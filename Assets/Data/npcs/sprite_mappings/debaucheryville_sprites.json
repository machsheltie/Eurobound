              "loop": true,
              "animation_notes": "Mouth movement, crypto jargon hand gestures"
            },
            "vape_cloud": {
              "frames": [[128, 64, 32, 32], [160, 64, 32, 32], [192, 64, 32, 32]],
              "frame_duration": 0.8,
              "loop": false,
              "triggers_particle": "vape_smoke_effect",
              "animation_notes": "Inhale, exhale with smoke particle effect",
              "interval_timing": 12.0
            },
            "phone_checking": {
              "frames": [[224, 64, 32, 32], [0, 96, 32, 32]],
              "frame_duration": 1.2,
              "loop": false,
              "triggers_audio": "phone_notification",
              "animation_notes": "Quick crypto price check, slight reaction to portfolio",
              "interval_timing": 8.0
            },
            "dismissive_wave": {
              "frames": [[32, 96, 32, 32], [64, 96, 32, 32]],
              "frame_duration": 0.6,
