              "loop": true,
              "animation_notes": "Forced smile, subtle nervous bounce, MBA diploma peeking from pocket"
            },
            "juggling_coins": {
              "frames": [[96, 0, 32, 32], [128, 0, 32, 32], [160, 0, 32, 32], [128, 0, 32, 32]],
