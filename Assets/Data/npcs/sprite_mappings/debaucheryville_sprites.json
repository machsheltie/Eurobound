            "conference_lanyard": {"position": [8, 12], "size": [16, 8]}
          }
        }
      }
    },
    "circus_performers.png": {
      "sheet_size": [256, 128], 
      "tile_size": [32, 32],
      "characters": {
        "crypto_clown": {
          "base_coordinates": [32, 0],
          "states": {
            "idle": {
              "frames": [[32, 0, 32, 32], [64, 0, 32, 32]],
