      "dialogue": {
        "greeting_with_passes": "I have performed for KINGS! For EMPERORS! For... wait, who are you?",
        "corridor_first_contact": "You are in my corridor. People who are in my corridor generally want something. What do you want, and say it beautifully, because I have a warm-up in nine minutes.",
        "compliment_ungraded": "Mm. That is what one says to a waiter.",
        "compliment_graded": "...The high F in Act Two. You listened.",
        "backstage_invitation": "You three are coming up. It is one flight of stairs and there is food.",
        "nightcap": "It is a JAGERBOMB, my darling, and it is BENEATH ME, and I have one every week.",
        "nightcap_toast": "Drei - zwei - eins - PROST!",
        "morning_after": "It was MEMORABLE. For me. - Eat the bread.",
        "callback_permanent": "The Nightcap boys! These three drank with me. ALL THREE. I have the photographs and I have shown them to the Maestro."
      },

