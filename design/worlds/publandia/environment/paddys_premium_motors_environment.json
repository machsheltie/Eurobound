    },
    "afternoon": {
      "lighting": "slightly_brighter_still_gray",
      "fergus_state": "behind_counter_waiting",
      "special_notes": "Peak tourist rental hours"
    },
    "evening": {
      "lighting": "golden_hour_briefly_then_gray",
      "fergus_state": "preparing_to_close",
      "special_notes": "Fergus watches the Cloverleaf on the horizon"
    },
    "closing_time": {
      "lighting": "interior_lights_off_exterior_dark",
      "fergus_state": "gone_home",
      "special_notes": "Door locked. Closed sign. Fergus stares at Mary's photo at home."
    }
  },
  
  "weather_effects": {
    "light_rain": {
      "modifier": 1.0,
