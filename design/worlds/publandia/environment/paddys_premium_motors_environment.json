        "volume": 0.2,
        "trigger": "random_interval_45s"
      },
      {
        "sound_id": "fluorescent_hum",
        "description": "Ancient fluorescent lights buzzing",
        "volume": 0.15,
        "loop": true,
        "location": "interior"
      },
      {
        "sound_id": "computer_fan",
        "description": "Ancient computer fan struggling",
        "volume": 0.1,
        "loop": true,
        "location": "interior"
      },
      {
        "sound_id": "keys_clinking",
        "description": "Keys on wall swaying slightly",
        "volume": 0.1,
        "trigger": "random_interval_60s"
      },
      {
