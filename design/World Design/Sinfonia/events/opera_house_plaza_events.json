  "minigame_events": {
    "rhythm_challenge": {
      "event_id": "street_performer_rhythm_minigame",
      "trigger_type": "player_interaction",
      "npc": "street_performer_violin_01",
      "prerequisite": "tip_5_euro",
      "minigame_parameters": {
        "type": "rhythm_matching",
        "song": "classical_violin_piece",
        "difficulty": "medium",
        "duration_seconds": 60,
        "scoring": {
          "perfect": 100,
          "good": 50,
          "miss": 0
        },
        "thresholds": {
          "pass": 600,
          "excellent": 900
        }
      },
      "rewards": {
        "pass": {
          "bravado": 3,
          "item": "sheet_music_classical"
        },
        "excellent": {
          "bravado": 5,
          "item": "sheet_music_classical",
          "status": "musically_gifted",
          "duration_hours": 2
        },
        "fail": {
          "bravado": -1,
          "status": "embarrassed",
          "duration_minutes": 10
        }
      },
      "dialogue_after": {
        "pass": "You have potential! Here, take this sheet music. Practice!",
        "excellent": "Remarkable! You have a natural sense of rhythm. Please, this is for you.",
        "fail": "Perhaps... try again another time. Music requires patience."
      }
    },
    
    "opera_knowledge_test": {
      "event_id": "guess_the_opera_dialogue",
      "trigger_type": "player_interaction",
      "npc": "random_opera_patron",
      "minigame_parameters": {
        "type": "dialogue_skill_check",
        "stat": "charm",
        "difficulty_threshold": 3,
        "bluff_option": true
      },
      "dialogue_sequence": [
        {
          "speaker": "opera_patron",
          "text": "Ah, you're attending tonight? Which aria are you most anticipating?"
        },
        {
          "choices": [
            {
              "text": "Oh, the famous one. With the singing.",
              "requires": {"charm": 4},
              "success": "vague_but_charming"
            },
            {
              "text": "I'm actually here for the architecture.",
              "requires": {"charm": 2},
              "success": "deflection"
            },
            {
              "text": "Uh... the loud part?",
              "requires": null,
              "result": "fail"
            }
          ]
        }
      ],
      "rewards": {
        "success": {
          "unlock": "opera_gossip_thread",
          "charm": 1
        },
        "fail": {
          "status": "culturally_exposed",
          "dialogue": "I see. Americans. *walks away*"
        }
      }
    }
  }
