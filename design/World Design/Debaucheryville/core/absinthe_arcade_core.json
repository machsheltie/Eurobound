  "spatial_identity": {
    "exterior_summary": "A dignified four-storey Prague-inspired limestone and plaster building disrespected by a monumental Green Fairy mural, green and purple conduit, the Headphone Gentleman carving, and a black neon arcade marquee.",
    "interior_summary": "A grand historic amusement hall with warm stone, iron mezzanines, amber lamps, checkerboard floors, and a monumental cracked absinthe-bottle bar corrupted by toxic neon, cabinet mist, bad signage, and lagging mirrors.",
    "layout": "central_hall_loop_with_l_shaped_north_wing",
    "primary_landmark": "aa_node_bottle_bar",
    "navigation_rule": "The central bottle bar remains visible from most main-floor nodes; the north wing deliberately compresses and obscures sightlines without becoming an unreadable maze."
  },
