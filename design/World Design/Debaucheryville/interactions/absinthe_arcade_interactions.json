  "narrator_commentary": {
    "on_entering": "Absinthe Arcade: where childhood nostalgia came to Europe, found itself, and immediately began charging admission.",
    "on_token_purchase": "The exchange rate had the confidence of a central bank and the oversight of a vending machine.",
    "on_claw_near_miss": "The claw had discovered free will at the exact moment it became expensive.",
    "on_restroom_unlock": "Three tokens later, modern sanitation had technically been achieved.",
    "on_taproom_discovery": "Behind the curtain waited either enlightenment or another cover charge.",
    "on_fake_vip_loop": "The VIP section was the friends they overpaid along the way."
  }
