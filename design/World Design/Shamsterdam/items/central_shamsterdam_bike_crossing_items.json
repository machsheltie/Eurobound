      "cost": 0,
      "effect": {
        "type": "hint",
        "content": [
          "Watch the patterns. Don't sprint.",
          "The island is a trap, not safety.",
          "Listen for the tram bells.",
          "The elderly are the fastest. Don't underestimate them."
        ]
      }
    },
    {
      "service_id": "first_aid",
      "provider_npc": "bike_rental_guy_01",
      "display_name": "First Aid",
      "description": "Basic medical attention after bicycle collision.",
      "cost": 5,
      "currency": "euro",
      "effect": {
        "type": "healing",
        "hp_restore": 15
      },
      "dialogue_on_purchase": "I've seen worse. Much worse."
    },
    {
      "service_id": "cafe_coffee",
      "provider_npc": "cafe_terrace_vendor",
