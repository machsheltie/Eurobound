      "display_name": "Bike Rental",
      "description": "Skip the crossing entirely by becoming part of the traffic. Now YOU'RE the problem.",
      "cost": 15,
      "currency": "euro",
      "duration": "1_day",
      "effect": {
        "type": "gameplay_bypass",
