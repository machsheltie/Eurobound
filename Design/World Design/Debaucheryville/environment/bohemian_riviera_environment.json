      "catapult_launch": "thunk_hisssss_splash.ogg",
      "mid_sentence_launch_q7_cutoff": "speech_clip_hard_cutoff_then_fading_over_water_1s.ogg",
      "jaxson_mic_feedback": "short_sharp_feedback_squeal.ogg",
      "jaxson_accent_slip": "single_clean_czech_syllable_leak.ogg",
      "aired_episode_bar_tv_loop": "crt_filtered_hostes_lowerthird_loop_20s.ogg"
    },
    "note": "The THUNK-hisssss-splash catapult impact note is reused unchanged as the show's de facto theme music, recognizable at low volume through a CRT filter on the bar TV loop."
  },

  "status_effects": {
    "environmental_buffs": [],
    "atmospheric_debuffs": ["port_o_cologne"],
    "location_specific_states": {
      "port_o_cologne": {
        "canonical_ref": "Design/Mechanics/Battle/status_effects.md#Port-O-Cologne",
        "trigger": "catapult_launch_and_wade_ashore, applied on contact with the shore (launched_into_bacchanus_in_a_loaded_port_o_potty)",
        "duration": "until_paid_shower_or_spa",
        "effects": {
          "charm_modifier": -3,
          "vendor_price_multiplier": 1.25,
          "romance_locked": true,
          "npc_reaction": "locals and vendors keep a polite distance"
        },
        "special": "bacchanus_swim_refreshes",
        "visual_indicator": "fly_swarm_particle_trail",
        "description": "A fly swarm trails any party member who has been launched into The Bacchanus and waded ashore. \"You smell like second place.\""
      }
    },
    "recovery_options": ["zdenka_riverbank_shower_cart_50kc_or_40kc_if_immediate"]
  },

  "couchsurf_integration": {
    "available": false,
    "reason": "outdoor_reality_tv_set_and_bar_district"
  },

  "time_of_day_changes": {
    "morning": {
      "lighting": "harsh_flat_beach_resort_brightness_heat_shimmer_building",
      "crowd_density": "medium",
      "special_notes": "Pre-taping setup on active filming days"
    },
    "day_filming": {
      "hours": "10:00-17:00, active tapings only",
      "lighting": "harsh_flat_beach_resort_brightness_heat_shimmer_off_sand",
      "crowd_density": "very_high",
      "special_notes": "Full production crew active at catapult_row and signup_table; maximum vacationer crowd density; EMTV crane live and swinging; space heaters running at full blast regardless of ambient temperature; trivia gauntlet and Sudden Death resolve during this window"
    },
    "golden_hour_posing": {
      "hours": "18:00-20:00",
      "lighting": "dramatic_orange_wash_across_the_river_silhouettes",
      "crowd_density": "high",
      "special_notes": "Filming wraps for the day; production crew breaks down but leaves the catapult roped off; vacationer crowd shifts to photo-op mode (flexing at the monitor, sunset selfies); bar strip terraces fill; unwritten golden-hour drink markup; best lighting for screenshots, worst for reading the NO DIVING sign"
    },
    "night_rave": {
      "hours": "22:00-04:00, post-Beatdown-completion only",
      "lighting": "string_light_pools_emtv_magenta_bar_tv_glow_lifeguard_spotlight_sweep",
      "crowd_density": "high",
      "special_notes": "night_party_zone unlocks and activates — string lights, migrating sound system, crowd that arrives from nowhere and stays until sunrise. Bar-strip TVs loop the aired episode at low volume under the music once episode_airing is true. This is the seed for a future 'Herp' questline — hook only, no new mechanics beyond ambient party dressing. Rosta's retrieval station goes quiet; port-o-potty monuments are lit by string lights and function as informal seating."
    },
    "late_night": {
      "lighting": "streetlamp_pools_and_dim_string_light_afterglow",
      "crowd_density": "low",
      "special_notes": "Only relevant pre-night_party_zone unlock"
    }
  },

  "weather_effects": {
    "clear": {
      "modifier": 1.0,
      "description": "default beach-resort conditions"
    },
    "overcast": {
      "modifier": 0.85,
      "description": "reduced golden-hour drama, crowd thins slightly"
    },
    "rain": {
      "modifier": 0.5,
      "audio": "rain_over_river_and_sand.ogg",
      "visual": "rain_particles_over_trucked_in_sand"
    }
  },

