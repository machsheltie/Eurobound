      "signup_headset_static": "headset_static.ogg",
      "signup_page_turn": "release_form_page_turn.ogg",
      "trivia_countdown_tick": "twelve_second_countdown_tick.ogg",
      "trivia_correct_chime": "correct_answer_chime.ogg",
      "trivia_strike_buzzer": "strike_buzzer.ogg",
      "trivia_crowd_chant": "pet_pet_pet_beer_chant.ogg",
      "sudden_death_oar_catch_release": "oar_catch_and_release_ramping_2s.ogg",
      "prize_podium_speedo_strut_fanfare": "speedo_strut_fanfare_sting.ogg",
      "prize_podium_badge_pin_click": "badge_pin_click.ogg",
