  "animation_sequences": {
    "vape_cloud_exhale": {
      "sprite_source": "particle_effect_sprites.vape_cloud_particles",
      "frames": 4,
      "duration_seconds": 1.5,
      "loop": true,
      "timing": {"fps_ambient": 3, "fps_dialogue_triggered_dense": 6},
      "note": "This is the vape_cloud_particles.png ambient/dialogue-triggered particle effect (4 frames each variant). Distinct from Vance's own 3-frame character-pose exhale animation (npc_sprites.vance_vallaro.vape_exhale_3frame), which is a separate NPC sprite-sheet asset."
    },
    "marquee_flicker": {
      "sprite_source": "effects.marquee_flicker",
      "frames": 4,
      "duration_seconds": 0.4,
      "loop": true,
      "timing": {"interval_seconds_min": 0.2, "interval_seconds_max": 0.6, "pattern": "randomized_not_metronomic"}
    },
    "prophecy_tent_glow_pulse": {
      "sprite_source": "effects.prophecy_tent_glow",
      "frames": 4,
      "duration_seconds": 4,
      "loop": true,
      "timing": {"idle_fps_effective": 1, "prophecy_in_progress_duration_seconds": 1.5, "prophecy_in_progress_speed_multiplier": 2.5},
      "note": "Idle and prophecy-in-progress states both loop continuously; state swap is instant, not crossfaded. Triggered by the same event window as Hamstradamus's own prophecy_trance animation (hamstradamus.md)."
    },
    "fax_machine_paper_spit": {
      "sprite_source": "sprite_sheets.fax_machine_and_flyers.fax_machine_paper_spit_3frame",
      "frames": 3,
      "duration_seconds": 1,
      "loop": false,
      "timing": {"synced_to": "paper_feed_chug_audio_cue"}
    },
    "ticket_dispenser_jam_and_release": {
      "sprite_source": "sprite_sheets.ticket_booth",
      "frames": 4,
      "duration_seconds": 2,
      "loop": false,
      "timing": {"jam_seconds": 1.2, "release_seconds": 0.8}
    },
    "knife_throw_dodge_round": {
      "sprite_source": "sprite_sheets.knife_target_board",
      "frames": 4,
      "duration_seconds": 1,
      "loop": false,
