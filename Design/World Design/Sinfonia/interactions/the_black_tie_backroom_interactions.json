    "phases": [
      {
        "phase": 1,
        "id": "the_read",
        "canonical_dialogue": [
          {"speaker": "chadwick", "text": "Look at this guy. He's drinking melted ice cream and chewing on sugar sticks. He's weak."}
        ],
        "staging_pointer": "quest_file"
      },
      {
        "phase": 2,
        "id": "the_all_in",
        "canonical_dialogue": [
          {"speaker": "lord_pilsner", "text": "Make the bet big. Show him what American capital looks like."}
        ],
        "staging_pointer": "quest_file"
      },
      {
        "phase": 3,
        "id": "the_vibes_speech",
        "canonical_dialogue": [
          {"speaker": "sinfonia_npc_aaron_unflappable_01", "text": "You guys are calculating numbers. You're looking at the board like it's a math test. Poker isn't math, bro. You gotta FEEL the turn. You gotta let the felt speak to you."}
        ],
        "staging_pointer": "quest_file"
      },
      {
        "phase": 4,
        "id": "the_call",
        "canonical_dialogue": [],
        "staging_pointer": "quest_file"
      },
      {
        "phase": 5,
        "id": "the_reveal",
        "canonical_dialogue": [
          {"speaker": "sinfonia_npc_aaron_unflappable_01", "text": "The kings were humming, man. They wanted to stretch their legs."}
        ],
        "staging_pointer": "quest_file"
      },
      {
        "phase": 6,
        "id": "the_sweep",
        "canonical_dialogue": [],
        "staging_pointer": "quest_file",
        "mechanical_effect": {"collateral_chips_removed_euro": 500}
      },
      {
        "phase": 7,
        "id": "the_sympathy_beat",
        "canonical_dialogue": [],
        "staging_pointer": "quest_file"
      },
      {
        "phase": 8,
        "id": "the_grants",
        "canonical_dialogue": [
          {"speaker": "sinfonia_npc_aaron_unflappable_01", "text": "Here. Take one. It helps with the hand jitters when you lose your shirt. Don't smoke it, just bite the end off. You want a hit of my White Russian to wash it down? No? Suit yourselves."},
          {"speaker": "sinfonia_npc_aaron_unflappable_01", "text": "It's on the chain. Digital land, baby. She Thinks My Tractor's Sexy. Limited drop. Mint #42. Hold onto that—that's your ticket back to the top."}
        ],
        "staging_pointer": "quest_file",
        "mechanical_effect": {"grants_items": ["item_candy_smokes", "item_tractor_nft"]}
      },
      {
        "phase": 9,
        "id": "the_exit",
        "canonical_dialogue": [
          {"speaker": "sinfonia_npc_aaron_unflappable_01", "text": "No cab vouchers, bro. But if you walk fast enough, you stay warm. Good luck with the felt next time!"}
        ],
        "staging_pointer": "quest_file",
        "mechanical_effect": {"sets_state": "post_kings_were_humming"}
      }
    ],

