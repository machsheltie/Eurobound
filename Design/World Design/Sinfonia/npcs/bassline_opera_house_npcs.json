      "npc_id": "sinfonia_npc_regisseur_hoffmann_01",
      "display_name": "Regisseur Heinrich Hoffmann",
      "role": "stage_director_chaos_victim",
      "zone": "backstage",
      "importance": "primary",
      
      "appearance": {
        "age": "50s_prematurely_grey",
        "build": "thin_nervous_energy",
        "face": {
          "features": "gaunt_intense",
          "expression_default": "focused_tense"
        },
        "clothing": {
          "shirt": "black_turtleneck",
          "accessories": ["directors_notebook", "reading_glasses_on_chain"],
          "shoes": "practical_black"
        }
      },
      
      "personality": {
        "core_traits": ["perfectionist", "passionate", "fragile_ego"],
        "speech_pattern": {
          "accent": "educated_german",
          "quirks": ["measure_references", "conservatory_name_drops", "escalating_despair"],
          "volume": "varies_dramatically"
        },
        "background": {
          "training": "conservatory_festival",
          "current_project": "die_zauberfloete",
          "project_duration": "8_months",
          "opening_night": "tomorrow"
        }
      },
      
      "dialogue": {
        "pre_chaos": {
          "directing": "The Queen enters on measure 47. MEASURE 47! Why is this difficult?!",
          "to_stranger": "Who are you? We do not have time for tourists. Rehearsal is sacred."
        },
        "chaos_phase": {
          "gustav_appears": "What is— no. No. This is not happening. I am hallucinating.",
          "destruction_begins": "THE PROPS! THE SNAKE! MY SNAKE!",
          "backdrop_tears": "THE BACKDROP! EIGHT MONTHS OF WORK!",
          "full_breakdown": "I studied at the Conservatory. I trained with legends. And a HORSE destroys my Zauberflöte."
        },
        "post_chaos": {
          "to_bros": "You. This is YOUR horse? You will pay. You will ALL pay. €2,000. MINIMUM.",
          "negotiation": "€2,000 is the minimum. The emotional damage? Incalculable.",
          "payment_received": "...fine. But you are banned from opening night. BANNED.",
          "unpaid": "I will find you. I have lawyers. Opera house lawyers."
        }
      },
      
      "animation_states": {
        "directing": {
          "frames": 6,
          "description": "Animated gestures, notebook waving",
          "loop": true
        },
        "horror": {
          "frames": 4,
          "description": "Freeze, glasses drop",
          "loop": false
        },
        "breakdown": {
          "frames": 2,
          "description": "Sitting on floor, head in hands",
          "loop": true
        },
        "fury": {
          "frames": 4,
          "description": "Red-faced, pointing, German screaming",
          "loop": true
        }
      },
      
      "schedule": {
        "10:00-17:00": "backstage_directing",
        "17:00-19:00": "dressing_rooms_final_notes",
        "19:00-22:00": "auditorium_wings"
      },
      
      "quest_role": {
