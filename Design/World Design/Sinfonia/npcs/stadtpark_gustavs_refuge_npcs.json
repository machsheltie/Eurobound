      "dialogue": {
        "arriving": "GUSTAV! Gustav, bitte, please! Come back to Hans-Jürgen!",
        "realization": "He is not running FROM something. He is running TO something. To... freedom.",
        "guilt": "Sixteen years. Sixteen years I work him. Never once I ask... is he happy?",
        "if_gustav_returns": "I will do better, Gustav. No more American bachelor parties. I promise.",
        "if_gustav_leaves": "Go, old friend. You have earned your... retirement.",
        "if_gustav_escapes": "He is gone. Gustav is gone forever. What have I done?"
      },
      
