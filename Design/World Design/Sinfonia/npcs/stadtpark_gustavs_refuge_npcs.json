      "dialogue": {
        "greeting": "Ah, you found him. Gustav knew you would come.",
        "translation_tired": "He tells me he is tired. Tired of the cobblestones. Tired of the tourists. Tired of the smell of beer.",
        "observation": "Gustav says... you are the first Americans who did not ask for a selfie.",
        "hint": "Give him the rainbow candies. He likes the rainbow candies.",
        "wisdom": "Sometimes freedom is not running away. Sometimes it is choosing to stay.",
        "departure": "The pigeons and I will watch over him. We always have."
      },
      
      "function": {
        "translates": "gustavs_body_language",
        "provides": "insight_into_emotional_state",
        "hints_at": "resolution_methods",
        "optional": true
      },
      
