  "couchsurf_integration": {
    "available": true,
    "location_type": "vehicle_based",
    "hosts": [
      {
        "host_id": "tour_bus_community",
        "host_npc": "orla_brennan_tour_leader_01",
        "trigger_conditions": [
          "circles_completed >= 5",
          "path_b_chosen"
        ],
        "accommodation_type": "bus_seats",
        "unique_benefits": [
          "community_orientation",
          "food_truck_schedule_knowledge",
          "lane_etiquette_training"
        ],
        "narrative_progression": "unlocks_tour_bus_community_backstories",
        "morning_dialogue": {
          "speaker": "orla_brennan_tour_leader_01",
          "text": "Morning! You survived your first night. Council meeting's at 10 if you'd like to participate in democracy."
        }
      },
      {
        "host_id": "patrick_and_margaret",
        "host_npc": "patrick_osullivan_01",
        "trigger_conditions": [
          "circles_completed >= 10",
          "path_b_day_2_complete"
        ],
        "accommodation_type": "wedding_van_back_seat",
        "unique_benefits": [
          "patrick_backstory_full",
          "wedding_advice",
          "acceptance_wisdom"
        ],
        "narrative_progression": "unlocks_margaret_truth_reveal",
        "morning_dialogue": {
          "speaker": "patrick_osullivan_01",
          "text": "Did you sleep well? Margaret and I stayed up watching the stars. Well, I watched. She rested."
        },
        "special_note": "Most emotionally impactful couchsurf in the game"
      }
    ]
  },
  
