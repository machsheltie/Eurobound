{
  "writers": [
    {
      "name": "Kimi",
      "model": "moonshotai/kimi-k3",
      "max_tokens": 32000,
      "params": {}
    },
    {
      "name": "Deepseek",
      "model": "deepseek/deepseek-v4.1-flash-1017",
      "max_tokens": 32000,
      "params": {}
    },
    {
      "name": "Mistral",
      "model": "mistralai/mistral-large-4-0",
      "max_tokens": 32000,
      "params": {}
    },
    {
      "name": "Aion",
      "model": "aion-labs/aion-3.5",
      "max_tokens": 32000,
      "params": {}
    }
  ],
  "providers": {
    "venice": {
      "base_url": "https://api.venice.ai/api/v1",
      "base_url_env": "VENICE_BASE_URL",
      "key_env": "VENICE_API_KEY",
      "body": {
        "venice_parameters": {
          "include_venice_system_prompt": false
        }
      }
    }
  },
  "finalizer": "Kimi",
  "default_rounds": 3,
  "budget_usd_per_run": 3.0,
  "max_tool_steps_per_turn": 24,
  "temperature": 0.9,
  "thread_chars_in_prompt": 60000,
  "bible_live_files": [
    {
      "path": ".claude/CLAUDE.md",
      "sections": [
        "Content rules (non-negotiable)",
        "Templates are mandatory",
        "Ask the author first",
        "Canon and standing rulings"
      ]
    },
    {
      "path": "design/narrative/Synopsis.md"
    }
  ],
  "satire_voice_glob": "~/.claude/skills/synced/*/eurobound-satire-voice/SKILL.md"
}
