  "npcs": [
    {
      "npc_id": "patrick_osullivan_01",
      "display_name": "Patrick O'Sullivan",
      "role": "eternal_groom_roundabout_elder",
      "vehicle": "wedding_van_1987",
      "duration_circling": "37_years",
      "original_destination": "cliffs_of_moher",
      
      "appearance": {
        "age_apparent": "70s",
        "age_when_entered": "30s",
        "clothing": {
          "main": "original_wedding_suit",
          "condition": "remarkably_preserved"
        },
        "hair": "grey_thinning_neatly_combed",
        "expression": "warm_genuine_occasional_wistfulness"
      },
      
      "personality": {
        "core_traits": ["loving", "accepting", "genuine", "optimistic_despite_everything"],
        "relationship_with_margaret": "unwavering_devotion",
        "mental_state": "denial_about_margarets_death",
        "speech_pattern": "warm_irish_accent_never_sad"
      },
      
      "key_quotes": [
        "First time? ...That's what they all say.",
        "We were on our honeymoon. Supposed to see the Cliffs of Moher. That was... 1987. We made the best of it.",
        "Margaret? She's just resting. Tired from all the circling.",
        "We raised our children right here in the van. They grew up, left the roundabout. Can you imagine? Leaving? They call sometimes.",
        "We celebrated our 37th anniversary last Tuesday. The tour bus threw us a party. Margaret loved it. She didn't say so, but I could tell.",
        "We could leave now, you know. They finally put in proper signage. But Margaret and I talked about it, and... this is home now.",
        "The secret is to enjoy the journey. The cliffs will still be there when we arrive."
      ],
      
      "voice_direction": "Irish accent, warm and genuine, occasional wistfulness when mentioning Margaret, never sad - accepting",
      "sprite_sheet": "wedding_van_1987.png",
      "animation_states": ["driving_content", "waving"]
    },
    
    {
      "npc_id": "margaret_skeleton_01",
      "display_name": "Margaret O'Sullivan (née Kelly)",
      "role": "eternal_bride",
      "state": "deceased_skeleton",
      "time_of_death": "late_1990s_estimated",
      "vehicle": "wedding_van_1987",
      "position": "passenger_seat",
      
      "appearance": {
        "state": "skeleton",
        "pose": "seated_looking_out_window",
        "clothing": {
