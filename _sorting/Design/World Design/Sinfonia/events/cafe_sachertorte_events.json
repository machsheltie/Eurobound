        },
        {
          "time": 7,
          "action": "npc_animation",
          "npc": "gustav",
          "animation": "satisfied_chewing"
        },
        {
          "time": 8,
          "action": "dialogue",
          "speaker": "lord_pilsner",
          "text": "Okay, we need to grab him NOW—"
        },
        {
          "time": 9,
          "action": "npc_animation",
          "npc": "gustav",
          "animation": "judgmental_stare_at_bros"
        },
        {
          "time": 10,
          "action": "sfx",
          "sound": "single_low_cello_note"
        }
