    "kitchen_chaos": {
      "event_id": "kitchen_through_sequence",
      "prerequisite": "chase_sequence_kitchen_door",
      "duration_seconds": 8,
      "sequence": [
        {
          "time": 0,
          "action": "npc_enter",
          "npc": "gustav",
          "location": "kitchen"
        },
        {
          "time": 0.5,
          "action": "sfx",
          "sound": "pots_crashing"
        },
        {
          "time": 1,
          "action": "dialogue_offscreen",
          "speaker": "chef_klaus",
          "text": "A HORSE! IN MY KITCHEN!",
          "language_note": "German with subtitles"
        },
        {
          "time": 2,
          "action": "sfx",
          "sound": "more_pots_chef_screaming"
        },
        {
          "time": 3,
          "action": "dialogue_offscreen",
          "speaker": "chef_klaus",
          "text": "GET OUT! RAUS! RAUS!"
        },
        {
          "time": 4,
          "action": "camera_shake",
          "intensity": "medium",
          "duration_seconds": 1
        },
        {
          "time": 5,
          "action": "sfx",
          "sound": "back_door_crash"
        },
        {
          "time": 6,
          "action": "npc_exit",
          "npc": "gustav",
          "exit_point": "kitchen_back_door",
          "destination": "alley_to_opera_backstage"
        }
      ]
    },
    
    "aftermath_sequence": {
      "event_id": "cafe_aftermath",
      "prerequisite": "gustav_exits_kitchen",
      "duration_seconds": 25,
      "sequence": [
        {
          "time": 0,
          "action": "music_change",
          "track": "aftermath_melancholy.ogg"
        },
        {
          "time": 1,
          "action": "camera_pan",
          "view": "destruction_survey"
        },
        {
          "time": 3,
          "action": "npc_animation",
          "npc": "herr_ober",
          "animation": "survey_damage_horror"
        },
        {
          "time": 5,
          "action": "dialogue",
          "speaker": "herr_ober",
          "text": "In thirty years of service, I have never... a HORSE. A HORSE ate the Sachertorte."
        },
        {
          "time": 8,
          "action": "ui_display",
          "element": "damage_total",
          "value": 340,
          "sfx": "final_register_ching"
        },
        {
          "time": 10,
          "action": "npc_animation",
          "npc": "herr_ober",
          "animation": "turns_to_bros_fury"
        },
        {
          "time": 11,
          "action": "dialogue",
          "speaker": "herr_ober",
          "text": "€340. You will pay this. Now. Or I call the Polizei."
        },
        {
          "time": 14,
          "action": "dialogue_choice",
          "options": [
            {
              "text": "We'll catch the horse and pay you back!",
              "response_type": "promise_payment",
              "result": {
                "debt_logged": true,
                "amount": 340,
                "quest_continues": true,
                "herr_ober_response": "You have 48 hours. I know where tourists stay."
              }
            },
            {
              "text": "Here's €340 right now.",
              "response_type": "immediate_payment",
              "requirement": {"euro": 340},
              "result": {
                "debt_cleared": true,
                "quest_continues": true,
                "herr_ober_response": "...acceptable. Now GET OUT and catch that horse!"
              }
            },
            {
              "text": "That horse doesn't belong to us!",
              "response_type": "denial",
              "result": {
                "triggers": "hans_jurgen_arrives",
                "debt_split": true,
                "amount_owed": 170
              }
            }
          ]
        }
      ]
    },
    
    "hans_jurgen_intervention": {
      "event_id": "hans_jurgen_cafe_arrival",
      "prerequisite": "denial_dialogue_choice",
      "duration_seconds": 15,
      "sequence": [
        {
          "time": 0,
          "action": "sfx",
          "sound": "door_burst_open"
        },
        {
          "time": 0.5,
          "action": "npc_enter",
          "npc": "hans_jurgen",
          "animation": "panicked_arrival"
        },
        {
          "time": 1,
          "action": "dialogue",
          "speaker": "hans_jurgen",
          "text": "GUSTAV! He was here?! Where did he go?!"
        },
        {
          "time": 3,
          "action": "npc_animation",
          "npc": "herr_ober",
          "animation": "points_at_hans_jurgen"
        },
        {
          "time": 3.5,
          "action": "dialogue",
          "speaker": "herr_ober",
          "text": "YOUR horse? YOU pay!"
        },
        {
          "time": 5,
          "action": "dialogue",
          "speaker": "hans_jurgen",
          "text": "I... my insurance... it covers half. Maybe. I think."
        },
        {
          "time": 7,
          "action": "ui_update",
          "element": "debt_display",
          "new_value": 170,
          "note": "Hans-Jürgen's insurance covers €170"
        },
        {
          "time": 9,
          "action": "dialogue",
          "speaker": "herr_ober",
          "text": "€170 from you. €170 from... these Americans. GO. Catch the horse. PAY ME."
        }
      ]
    },
    
    "exit_to_next_location": {
      "event_id": "proceed_to_opera_backstage",
      "prerequisite": "aftermath_complete",
      "sequence": [
        {
          "time": 0,
          "action": "dialogue",
          "speaker": "lord_pilsner",
          "text": "Which way did he go?"
        },
        {
          "time": 2,
          "action": "dialogue",
          "speaker": "chef_klaus",
          "text": "Through the alley! Toward the opera house! Thirty years. Thirty years no horse in my kitchen..."
        },
        {
          "time": 5,
          "action": "quest_marker",
          "destination": "sinfonia_opera_backstage_01",
          "marker_text": "Follow Gustav"
        },
        {
          "time": 6,
          "action": "location_unlock",
          "location": "sinfonia_opera_backstage_01",
          "access_point": "kitchen_alley"
        }
      ]
    }
