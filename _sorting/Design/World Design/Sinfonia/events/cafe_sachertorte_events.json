  "return_events": {
    "post_quest_return_unpaid": {
      "event_id": "cafe_return_debt_active",
      "trigger_type": "enter_location_post_quest",
      "condition": "debt_unpaid",
      "sequence": [
        {
          "time": 0,
          "action": "npc_intercept",
          "npc": "herr_ober",
          "position": "door"
        },
        {
          "time": 0.5,
          "action": "dialogue",
          "speaker": "herr_ober",
          "text": "You. OUT. Until the €[remaining_debt] is paid, you are not welcome."
        },
        {
          "time": 2,
          "action": "dialogue_choice",
          "options": [
            {
              "text": "Here's €[amount].",
              "response_type": "partial_payment",
              "interface": "payment_slider"
            },
            {
              "text": "We'll come back later.",
              "response_type": "leave",
              "result": "exit_location"
            }
          ]
        }
      ]
    },
    
    "post_quest_return_paid": {
      "event_id": "cafe_return_valued_patron",
      "trigger_type": "enter_location_post_quest",
      "condition": "debt_paid",
      "sequence": [
        {
          "time": 0,
          "action": "npc_approach",
          "npc": "herr_ober",
          "animation": "reluctant_respect"
        },
        {
          "time": 1,
          "action": "dialogue",
          "speaker": "herr_ober",
          "text": "...you returned. And you paid. This way. We have a new item. 'The Gustav.' Horse-shaped. You will appreciate the irony."
        }
      ]
    }
  },
  
  "ambient_events": {
