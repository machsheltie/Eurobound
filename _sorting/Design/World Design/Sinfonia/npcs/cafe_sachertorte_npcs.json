      "dialogue": {
        "greeting": {
          "default": "Welcome to Café Sachertorte. You have... a reservation?",
          "tourist_detected": "Ah. Americans. The... terrace is available. By the restroom.",
          "charm_high": "Welcome. I have a table by the window. This way, please."
        },
        "ordering": {
          "coffee_generic": "Ah. You would like... 'a coffee.' How... specific.",
          "coffee_correct": "Ein Melange. Very good. Perhaps there is hope.",
          "cake_order": "The Sachertorte. An excellent choice. Obviously.",
          "american_request": "'Iced coffee.' Sir, this is not... a diner."
        },
        "judgment": {
          "photo_taking": "You take PHOTOS of the cake? This is not Instagram. This is Sachertorte.",
          "price_complaint": "The price has not changed since 2019. The quality has not changed since 1832.",
          "tip_insufficient": "...I see. Thank you for your... generosity."
        },
        "chaos_phase": {
          "gustav_entry": "What is—MEIN GOTT! EIN PFERD!",
          "cake_eaten": "NEIN! NEIN! DAS PFERD FRISST DIE TORTE!",
          "damage_reaction": "THE TABLES! THE DISPLAY! THIS WILL COST—calculate—€340!",
          "breakdown": "In thirty years of service, I have never... a HORSE. A HORSE ate the Sachertorte."
        },
        "post_chaos": {
          "debt_demand": "€340. You will pay this. Now. Or I call the Polizei.",
          "partial_payment": "€50 received. You still owe €290. I will remember.",
          "full_payment": "...paid in full. You may return. But I will be watching.",
          "unpaid_return": "You. OUT. Until the €340 is paid, you are not welcome."
        }
      },
      
