# Godot (project lives in game/)
.godot/
.import/
game/android/
game/assets/data/saves/*.save

# Build output
builds/*
!builds/readme.md
*.tmp

# Development tools
tools/__pycache__/
*.log

# Marketing (large files)
marketing/trailers/raw_footage/
marketing/screenshots/originals/

# Local AI-tool workspace state
.refact/

# Git worktrees (local agent windows)
.worktrees/
.bmad-loop/runs/
.bmad-loop/cache/
.bmad-loop/policy.toml
_bmad/render/

# Blender autosave backups
*.blend1
*.blend2

# Large 3D binaries stay out of git (author ruling 2026-10-27: no GitHub storage
# for them). They live on disk only; back them up separately.
*.blend
*.glb
*.fbx
Assets/Graphics/worlds/**/*.png
Assets/Graphics/worlds/**/*.jpg
Assets/Graphics/worlds/**/*.jpeg

tools/art_cleanup/.venv/
# Godot MCP Pro (paid, proprietary licence: keep out of git)
tools/godot_mcp_pro_server/
game/addons/godot_mcp/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Session-log hook state (per machine)
production/session-logs/.last-logged-head
Production/session-logs/.last-logged-head

# Canon search index (tools/canon_index): venv and rebuildable index
tools/canon_index/.venv/
tools/canon_index/.index/

# Python bytecode caches (any depth)
**/__pycache__/
*.pyc
